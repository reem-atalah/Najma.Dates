{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "najma-dates",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "RESEND_FROM": "Najma Dates <info@najma-dates.com>"
  },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/product*"]
  }
}
